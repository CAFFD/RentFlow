{
  "exchanges": [
    {
      "name": "rentflow.falhas",
      "vhost": "rentflow",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "rentflow.estacionamento",
      "vhost": "rentflow",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic"
      }
    }
  ],
  "bindings": [
    {
      "source": "rentflow.falhas",
      "vhost": "rentflow",
      "destination": "rentflow.estacionamento",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "vhost": "rentflow",
      "name": "falhas-nucleo",
      "pattern": "^(retirada|comunicacao|manutencao|auditoria|preparacao)\\.queue$",
      "definition": {
        "dead-letter-exchange": "rentflow.falhas"
      },
      "priority": 5,
      "apply-to": "queues"
    }
  ]
}
